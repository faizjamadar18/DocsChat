# Root .gitignore

# Env files (never commit secrets)
.env
.env.local

# IDE / OS
.vscode/
.idea/
.DS_Store

# Python / test noise (never commit local run metadata)
__pycache__/
.pytest_cache/

# Local AI agent config (personal workflows stay out of the repo)
.agents/
.aider*
.cursor*
.gemini/
*.scratch.*
