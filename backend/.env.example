# MongoDB Atlas connection string
MONGODB_URL=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/
DB_NAME=notebuddy

# JWT Configuration
JWT_SECRET=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
# LLM API Keys
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b

# RAG Configuration
GOOGLE_EMBEDDING_MODEL=models/text-embedding-004
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_FILE_SIZE_MB=20
# Qdrant Configuration
QDRANT_URL=https://your-cluster-url.qdrant.io
QDRANT_API_KEY=your-api-key

# Ora Voice (BYOK — no server secrets needed)
# Each user pastes their OWN Vapi public key in Settings -> Account.
# Keys are encrypted at rest with JWT_SECRET. Never ask users for Vapi private keys.

# Notion Connector (OAuth public integration — free, no credit card)
# Create at notion.so/my-integrations -> Public integration, read-only.
NOTION_CLIENT_ID=your-notion-client-id
NOTION_CLIENT_SECRET=your-notion-client-secret
NOTION_REDIRECT_URI=https://your-render-app.onrender.com/api/connectors/notion/callback
FRONTEND_URL=https://your-vercel-app.vercel.app

# Google Drive Connector (OAuth, drive.file scope only — non-sensitive, free)
# Same Google Cloud project as login: enable Drive API + Picker API,
# create Web OAuth client + browser API key (see checklist from agent).
GOOGLE_DRIVE_CLIENT_ID=your-drive-oauth-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-drive-oauth-client-secret
GOOGLE_DRIVE_REDIRECT_URI=https://your-render-app.onrender.com/api/connectors/drive/callback

# GitHub Connector (GitHub App, free — register at github.com/settings/apps)
# Permissions: Contents read-only + Metadata read-only. User picks repos at install.
GITHUB_APP_CLIENT_ID=your-github-app-client-id
GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret
GITHUB_APP_REDIRECT_URI=https://your-render-app.onrender.com/api/connectors/github/callback

# MCP Server (remote, Streamable HTTP — free, official MCP SDK)
# Public URL of this backend. Leave empty for local dev (derived from request).
# In production set both to your Render URL so Claude/Grok discovery works.
MCP_SERVER_URL=https://your-render-app.onrender.com/mcp
MCP_ISSUER_URL=https://your-render-app.onrender.com
# Claude's fixed callback is https://claude.ai/api/mcp/auth_callback
# (no allowlist needed on our side; our /oauth/register accepts it as https).
